      "id": "8c5ad858-d1b0-45eb-8226-a402c8f00637",
      "name": "Fetch Posts",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.all().map(item => item.json);\n\nconst selected = posts\n  .filter(post =>\n    Number.isInteger(post.id) &&\n    Number.isInteger(post.userId) &&\n    typeof post.title === 'string' &&\n    typeof post.body === 'string'\n  )\n  .sort((a, b) => b.id - a.id)\n  .slice(0, 5);\n\nif (selected.length === 0) {\n  throw new Error('The API returned no valid posts.');\n}\n\nreturn [{\n  json: {\n    posts: selected,\n    topPost: selected[0],\n    count: selected.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "d804c281-3c99-4380-ae30-2f06908c2138",
      "name": "Select Top 5"
    },
    {
      "parameters": {
        "url": "={{ 'https://jsonplaceholder.typicode.com/users/' + $json.topPost.userId }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        576,
        0
      ],
      "id": "b70ebcf1-457d-4a59-af5a-25cad0e1125b",
      "name": "Fetch Author",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Select Top 5').first().json;\nconst author = $input.first().json;\n\nif (typeof author.name !== 'string') {\n  throw new Error('The author response is missing a name.');\n}\n\nconst wordCount = data.topPost.body\n  .trim()\n  .split(/\\s+/)\n  .filter(Boolean)\n  .length;\n\nconst titles = data.posts.map((post, index) =>\n  `${index + 1}. ${post.title}`\n);\n\nconst message = [\n  'POST DIGEST — SAMPLE DATA',\n  `Generated: ${new Date().toISOString()}`,\n  '',\n  ...titles,\n  '',\n  `Top post author: ${author.name}`,\n  `Company: ${author.company?.name ?? 'Not available'}`,\n  `Top post length: ${wordCount} words`\n].join('\\n');\n\nreturn [{\n  json: {\n    message,\n    wordCount,\n    threshold: 30\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "id": "f3a2bc68-bcd3-4a9b-b3a4-cd9fcb075c0f",
      "name": "Build Digest"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "0b0039a9-fd6b-4724-b34e-f7dbb5efe78f",
              "leftValue": "={{ $json.wordCount }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1024,
        0
      ],
      "id": "69e8711e-4d48-4326-ae52-918d3c3c05f9",
