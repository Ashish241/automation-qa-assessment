      "parameters": {
        "jsCode": "const failure = $input.first().json;\n\nconst detail =\n  typeof failure.error === 'string'\n    ? failure.error\n    : failure.error?.message ??\n      failure.message ??\n      'API request failed. Check the execution details.';\n\nreturn [{\n  json: {\n    message: [\n      'DIGEST FAILED',\n      `Time: ${new Date().toISOString()}`,\n      `Details: ${String(detail).slice(0, 500)}`,\n      'The normal digest could not be completed.'\n    ].join('\\n')\n  }\n}];"
      },
